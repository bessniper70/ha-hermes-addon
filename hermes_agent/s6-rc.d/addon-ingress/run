#!/command/with-contenv sh
set -eu
export HOME=/data
cd /data

mkdir -p /data/nginx/body /data/nginx/proxy /data/nginx/fastcgi /data/nginx/uwsgi /data/nginx/scgi
chown -R hermes:hermes /data/nginx
chmod 0750 /data/nginx /data/nginx/body /data/nginx/proxy /data/nginx/fastcgi /data/nginx/uwsgi /data/nginx/scgi

TTYD_PID=""
NGINX_PID=""

shutdown() {
  if [ -n "${NGINX_PID}" ]; then kill -TERM "${NGINX_PID}" 2>/dev/null || true; fi
  if [ -n "${TTYD_PID}" ]; then kill -TERM "${TTYD_PID}" 2>/dev/null || true; fi
  [ -z "${NGINX_PID}" ] || wait "${NGINX_PID}" 2>/dev/null || true
  [ -z "${TTYD_PID}" ] || wait "${TTYD_PID}" 2>/dev/null || true
}
trap shutdown INT TERM EXIT

if [ "${ENABLE_TERMINAL:-true}" = "true" ]; then
  echo "[addon-ingress] Starting web terminal on port 7681"
  s6-setuidgid hermes ttyd -W -i 127.0.0.1 -p 7681 -b /terminal bash -l &
  TTYD_PID=$!
fi

echo "[addon-ingress] Starting nginx ingress on port 9119"
s6-setuidgid hermes nginx -g 'daemon off;' &
NGINX_PID=$!
wait "${NGINX_PID}"
